generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  OWNER
  ADMIN
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Gender {
  MALE
  FEMALE
  UNISEX
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  password  String
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings      Listing[]
  reviews       Review[]
  inquiries     Inquiry[]

  @@map("users")
}

model Listing {
  id          String        @id @default(cuid())
  name        String
  description String?
  city        String
  locality    String
  address     String
  gender      Gender
  totalBeds   Int
  status      ListingStatus @default(PENDING)
  isFeatured  Boolean       @default(false)
  isVerified  Boolean       @default(false)
  occupancy   String?
  amenities   String[]
  rules       String[]
  images      String[]
  latitude    Float?
  longitude   Float?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  owner     User      @relation(fields: [ownerId], references: [id])
  ownerId   String
  pricing   Pricing[]
  reviews   Review[]
  inquiries Inquiry[]

  @@index([city])
  @@index([locality])
  @@index([status])
  @@index([isFeatured])
  @@map("listings")
}

model Pricing {
  id       String @id @default(cuid())
  type     String
  price    Int
  meals    String?

  listing  Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String

  @@map("pricing")
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  user     User    @relation(fields: [userId], references: [id])
  userId   String
  listing  Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String

  @@map("reviews")
}

model Inquiry {
  id        String   @id @default(cuid())
  message   String?
  phone     String?
  status    String   @default("pending")
  createdAt DateTime @default(now())

  user      User    @relation(fields: [userId], references: [id])
  userId    String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String

  @@map("inquiries")
}
